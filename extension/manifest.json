{
  "manifest_version": 3,
  "name": "Live Subtitles",
  "version": "0.2.0",
  "description": "Tells the Live Subtitles app where the video on this page is, so movie and TV subtitles line up exactly.",
  "permissions": ["webRequest", "storage", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["classify.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Live Subtitles" }
}
